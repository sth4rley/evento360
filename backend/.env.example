# Conexão ao PostgreSQL (porta padrão 5432)
DATABASE_URL=postgresql://evento360:change-me@127.0.0.1:5432/evento360?schema=public
TEST_DATABASE_URL=postgresql://evento360:change-me@127.0.0.1:5432/evento360_test?schema=public

# Configurações gerais
NODE_ENV=development
PORT=3000

# URLs do frontend (usado para CORS e redirecionamentos)
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Resend (serviço de e‑mail) – preencha se for usar, caso contrário deixe vazio
RESEND_API_KEY=sua_chave_aqui
RESEND_FROM_EMAIL=ingressos@seuevento.com.br   # <‑ mantenha apenas esta linha

# Integração opcional com n8n – deixe vazio se não usar
N8N_REGISTRATION_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Credenciais do container PostgreSQL (geradas pelo docker‑compose)
POSTGRES_USER=evento360
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evento360

# Segredo usado para assinar JWTs (≥ 32 caracteres)
AUTH_TOKEN_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
# Crie estas credenciais no Google Cloud Console; nunca versione valores reais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/public/auth/google/callback

# WAHA (serviço de SMS/WhatsApp)
WAHA_API_KEY_SHA512=replace-with-the-sha512-hash-of-the-local-api-key
WAHA_DASHBOARD_USERNAME=evento360_admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password

# (opcional) linhas em branco ou comentários adicionais
